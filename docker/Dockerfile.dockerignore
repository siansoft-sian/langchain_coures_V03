# Files Docker must not copy into the image.
# (Docker reads this file because it sits next to the Dockerfile with the same name.)

# Secrets
.env
.env.*
*.pem
*.key

# Local environments and caches
.venv
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Git and editor files
.git
.gitignore
.vscode/
.idea/
.DS_Store

# Not needed inside the image
ci/
docker/
project_config.py
tests/
.github/
.pre-commit-config.yaml
docker-compose.yml
.env.example
